{
  "mcpServers": {
    "protonmail-local-ai": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.14.3",
        "http://localhost:3000/mcp",
        "--transport",
        "http-only",
        "--header-file",
        "/ABSOLUTE/PATH/TO/protonmail-local-ai/.secrets/mcp_client_headers.txt"
      ]
    }
  }
}
