# Secrets — never commit these
.env
# A copy of .env that an interrupted scripts/init-account-scope.sh can leave
.env.account-scope.*
.env.eval
.secrets/
*.pem
*.key

# Docker volumes if mounted locally
data/
maildir/
# ``indexer/src/data/`` is bundled source data (e.g. the qwen3-embedding
# tokenizer.json) — exempt it from the broad ``data/`` ignore above so
# the data files ship in the indexer image build context.
!indexer/src/data/
!indexer/src/data/**

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Per-checkout uv cache set by the Makefile (UV_CACHE_DIR); also keeps it
# out of Semgrep scans through .semgrepignore
.uv-cache/
dist/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Claude Code
.claude/

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Build artifacts
*.db
*.sqlite

# Logs
*.log
logs/

# Operator source-authority rules: real addresses and domains. The
# ``.example`` companion is tracked.
config/authority.toml
# The operator's own addresses (#824). The ``.example`` companion is
# tracked.
config/identity.toml
# The operator configuration (#1607): addresses and the Bridge username.
# The ``.example`` companion is tracked.
config/config.toml
# What scripts/config/operator_config.py writes from it.
.generated/

# Eval queries grounded in a real mailbox — must never be committed.
# The ``.example`` companions are tracked as schema/templates.
mcp-server/tests/eval/queries.json
mcp-server/tests/eval/eval-queries.md

# Answer-evaluation run reports and detail artifacts (make eval-answers).
.answer-eval/

# Real-embedder baseline vector cache (make baseline-real-embedder).
.real-embedder-cache/
