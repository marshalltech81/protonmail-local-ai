# Build context: mbsync/
# Only Dockerfile, entrypoint.sh, and mbsyncrc.template are needed.
.dockerignore
*.md
# TLS cert is extracted at runtime — never bake it into the image
*.pem
# Entrypoint tests run in CI, not in the image
tests/
# Local uv cache (Makefile UV_CACHE_DIR) — never part of a build context
.uv-cache/
