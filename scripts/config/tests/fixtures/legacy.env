# A synthetic .env with every .env.example setting at its documented
# default and synthetic required values: the "today" side of the
# equivalence test with legacy.toml (scripts/config/tests).
SOURCE_MODE=proton-bridge
ACCOUNT_SCOPE=00000000-0000-4000-8000-000000000001
BRIDGE_USER=synthetic@example.com
BRIDGE_IMAP_PORT=1143
BRIDGE_CERT_FINGERPRINT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BRIDGE_HOST=host.docker.internal
BRIDGE_CERT_HOST=127.0.0.1
PROTON_IMAP_ACCOUNT_NAME=protonmail
PROTON_REMOTE_STORE_NAME=protonmail-remote
PROTON_LOCAL_STORE_NAME=protonmail-local
PROTON_CHANNEL_NAME=protonmail
PROTON_FOLDER_EXCLUSIONS=All Mail|Labels/*|Starred
SYNC_INTERVAL=60
SYNC_DEADLINE_SECONDS=86400
EMBED_MODE=openai
EMBED_BASE_URL=http://host.docker.internal:8001/v1
EMBED_MODEL=synthetic-embed-model
EMBED_TIMEOUT_SECS=60
EMBED_BATCH_SIZE=64
EMBED_CONCURRENCY=1
INITIAL_INDEX_BATCH_SIZE=50
INDEXER_STEADY_STATE_BATCH_SIZE=8
INDEXER_WAL_CHECKPOINT_INTERVAL_SECS=600
INDEXER_RECOVERY_SWEEP_INTERVAL_SECS=1800
RERANK_MODE=none
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_CANDIDATES=20
RERANK_TIMEOUT_SECS=60
EMBED_WARMUP_TIMEOUT_SECS=600
INFERENCE_MODE=none
INFERENCE_BASE_URL=
INFERENCE_MODEL=claude-sonnet-5-5
INFERENCE_TIMEOUT_SECS=300
INFERENCE_MAX_TOKENS=
INFERENCE_CONTEXT_TOKENS=
INFERENCE_STRUCTURED_OUTPUT=true
INDEXER_DELETION_ENABLED=true
INDEXER_DELETION_GRACE_DAYS=7
INDEXER_DELETION_SWEEP_INTERVAL_SECS=3600
INDEXER_DELETION_MAX_BATCH_PCT=0.05
INDEXER_MAX_ATTEMPTS=5
INDEXER_RETRY_BASE_SECONDS=30
INDEXER_MESSAGE_TIMEOUT_SECONDS=3600
INDEXER_CHUNK_TARGET_TOKENS=1000
INDEXER_CHUNK_MAX_TOKENS=1500
INDEXER_CHUNK_OVERLAP_TOKENS=150
INDEXER_PARSE_MAX_BYTES=50000000
INDEXER_ATTACHMENT_EXTRACTION_ENABLED=true
INDEXER_OCR_ENABLED=true
INDEXER_ATTACHMENT_MAX_BYTES=33554432
INDEXER_OCR_MAX_PAGES=20
INDEXER_OCR_TIMEOUT_SECONDS=60
INDEXER_PDF_MAX_DIGITAL_PAGES=500
INDEXER_ATTACHMENT_MAX_EXTRACTED_CHARS=2000000
MCP_PORT=3000
MCP_TRANSPORT=streamable-http
MCP_SESSION_IDLE_TIMEOUT_SECS=1800
MCP_EXPERIMENTAL_TOOLS=false
